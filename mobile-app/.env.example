# LMS Mobile App Environment Variables

# API Configuration
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api

# Note: Replace 192.168.1.100 with your actual Laravel backend server IP/hostname
# For Android Emulator: use your machine IP address
# For iOS Simulator: use localhost:8000/api or your machine IP
# For Physical Device: use your machine IP address on the same network

# Enable Debug Logging (development only)
EXPO_PUBLIC_DEBUG=false

# App Configuration
EXPO_PUBLIC_APP_NAME=LMS Mobile
EXPO_PUBLIC_APP_VERSION=1.0.0
